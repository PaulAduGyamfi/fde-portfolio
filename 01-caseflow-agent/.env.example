# CaseFlow configuration.
# Copy to .env and fill in.

# Model provider key. Asserted at import in caseflow/llm.py,
# so the app fails to start without it rather than failing on the first call.
OPENAI_API_KEY=sk-...

# Shared secret for the API. Sent as the x-api-key header on every
# route except /health, which stays open for uptime checks.
API_KEY=choose-any-string

# Optional. Read in caseflow/llm.py, currently unused.
LLM_PROVIDER=openai